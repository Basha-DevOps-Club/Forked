{
  "meta": {
    "name": "Forked Design Tokens",
    "schemaVersion": "1.0.0",
    "description": "Platform-agnostic source tokens for the Forked Learn web app and companion editor experiences.",
    "colorVariantContract": {
      "base": "Approved identity color for non-text accents, diagrams, badges, and progress.",
      "action": "Accessible light-appearance fill for controls using color.onAccent.light.",
      "text": "Accessible light-appearance value for links, labels, and other small text.",
      "dark": "Accessible dark-appearance value for fills, focus, progress, links, and labels using color.onAccent.dark when text appears on the color."
    },
    "accessibility": {
      "standard": "WCAG 2.2 AA",
      "normalTextMinimum": "4.5:1",
      "largeTextAndInteractiveBoundaryMinimum": "3:1",
      "testedPairs": [
        "color.accent.*.action with color.onAccent.light",
        "color.accent.*.text on color.neutral.light.canvas and color.neutral.light.surface",
        "color.accent.*.dark on color.neutral.dark.canvas and color.neutral.dark.surface",
        "color.onAccent.dark on color.accent.*.dark"
      ]
    }
  },
  "color": {
    "neutral": {
      "light": {
        "canvas": "#F7F1E8",
        "surface": "#FFFCF7",
        "text": "#1C1813",
        "muted": "#70675D",
        "border": "#E3D8C9",
        "borderStrong": "#958A7F"
      },
      "dark": {
